-- Nicht jeder Executor kann die Zwischenablage lesen. Wenn er es kann, holen
-- wir den Schluessel von selbst, sobald er dort auftaucht.
local readClip = getclipboard or get_clipboard or getclipboardtext or readclipboard
if not readClip and type(Clipboard) == "table" then
    readClip = Clipboard.get
end
if type(readClip) ~= "function" then readClip = nil end

local KEY_SHAPE = "^JLCFG%-[%w_%-]+$"

local function keyFromClipboard()
    if not readClip then return nil end
    local ok, text = pcall(readClip)
    if not ok or type(text) ~= "string" then return nil end
    text = text:match("^%s*(.-)%s*$")
    if #text == 38 and text:match(KEY_SHAPE) then return text end
    return nil
end

-- Der Schluessel wird lokal abgelegt, damit man ihn nur einmal eintippen muss.
-- Er wird trotzdem bei jedem Start beim Server nachgeprueft, und sobald der ihn
-- nicht mehr anerkennt, fliegt die Datei raus und das Fenster kommt zurueck.
local FOLDER = "JLCFG"
-- Je Skript eine eigene Datei. Sonst wuerde der Schluessel des einen den des
-- anderen ueberschreiben, und beide Skripte fragen staendig neu.
local KEYFILE = FOLDER .. "/key_" .. PRODUCT .. ".txt"
local canStore = type(writefile) == "function"
    and type(readfile) == "function"
    and type(isfile) == "function"

local function loadSaved()
    if not canStore then return nil end
    local ok, present = pcall(isfile, KEYFILE)
    if not ok or not present then return nil end
    local read, text = pcall(readfile, KEYFILE)
    if not read or type(text) ~= "string" then return nil end
    text = text:match("^%s*(.-)%s*$")
    if #text == 38 and text:match(KEY_SHAPE) then return text end
    return nil
end

local function saveKey(value)
    if not canStore then return end
    if type(makefolder) == "function" and type(isfolder) == "function" then
        local ok, present = pcall(isfolder, FOLDER)
        if ok and not present then pcall(makefolder, FOLDER) end
    end
    pcall(writefile, KEYFILE, value)
end

-- Nur den Schluessel vergessen, der wirklich gescheitert ist. Ohne das
-- "which" riss ein falscher Schluessel aus der Zwischenablage den
-- gespeicherten, funktionierenden mit, und der Nutzer musste die Werbung neu
-- schauen, obwohl sein eigener Schluessel noch gueltig war.
local function forgetKey(which)
    if not canStore then return end
    if which then
        local stored = loadSaved()
        if stored and stored ~= which then return end
    end
    if type(delfile) == "function" then
        pcall(delfile, KEYFILE)
    else
        pcall(writefile, KEYFILE, "")
    end
end

-- Abgelehnte Schluessel merken. Sonst greift der Waechter bei jedem Rejoin
-- erneut denselben alten Schluessel aus der Zwischenablage und laeuft in
-- dieselbe Ablehnung. Es reicht, den letzten zu behalten, mehr liegt dort
-- praktisch nie.
local REJECTFILE = FOLDER .. "/rejected_" .. PRODUCT .. ".txt"

local function wasRejected(key)
    if not canStore then return false end
    local ok, present = pcall(isfile, REJECTFILE)
    if not ok or not present then return false end
    local read, text = pcall(readfile, REJECTFILE)
    if not read or type(text) ~= "string" then return false end
    for line in tostring(text):gmatch("[^\r\n]+") do
        if line:match("^%s*(.-)%s*$") == key then return true end
    end
    return false
end

local function rememberReject(key)
    if not canStore or wasRejected(key) then return end
    local text = ""
    local ok, present = pcall(isfile, REJECTFILE)
    if ok and present then
        local read, old = pcall(readfile, REJECTFILE)
        if read and type(old) == "string" then text = old end
    end
    -- Hoechstens die letzten fuenf behalten, die Datei soll nicht wachsen.
    local lines = {}
    for line in tostring(text):gmatch("[^\r\n]+") do
        lines[#lines + 1] = line
    end
    lines[#lines + 1] = key
    while #lines > 5 do
        table.remove(lines, 1)
    end
    pcall(function() makefolder(FOLDER) end)
    pcall(writefile, REJECTFILE, table.concat(lines, "\n"))
end

