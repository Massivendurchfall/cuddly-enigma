-- Liegt ein Schluessel von letztem Mal vor, wird er still geprueft. Klappt es,
-- sieht man das Fenster gar nicht erst. Klappt es nicht, geht es auf und sagt
-- warum, zum Beispiel weil die acht Stunden um sind.
--
-- Das muss vor dem Waechter passieren. Lief beides gleichzeitig, konnte ein
-- alter Schluessel aus der Zwischenablage dem gespeicherten zuvorkommen.
local savedDone = false
local saved = loadSaved()
if saved then
    gui.Enabled = false
    task.spawn(function()
        attempt(saved)
        savedDone = true
        if not env.JLCFG_RUNNING and gui.Parent then
            gui.Enabled = true
        end
    end)
else
    savedDone = true
end

-- Wacht ueber die Zwischenablage: taucht dort ein Schluessel auf, wandert er
-- ins Feld und die Pruefung startet von selbst. Schon abgelehnte werden
-- uebergangen, sonst greift der Waechter nach jedem Rejoin wieder denselben.
if readClip then
    say("Copy the link below for your " .. SCRIPT_NAME
        .. " key, then come back. It is picked up automatically.")
    task.spawn(function()
        while not savedDone and gui.Parent and not env.JLCFG_RUNNING do
            task.wait(0.2)
        end
        local seen = ""
        while gui.Parent and not env.JLCFG_RUNNING do
            local found = keyFromClipboard()
            if found and found ~= seen and not busy and not wasRejected(found) then
                seen = found
                input.Text = found
                say("Key found in your clipboard. Checking\u{2026}", true)
                attempt(found)
            end
            task.wait(0.5)
        end
    end)
end
