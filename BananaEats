--------------------------------------------------------------------- Server

local function api(path, bearer)
    local ok, response = pcall(send, {
        Url = BASE .. path,
        Method = "POST",
        Headers = {
            Authorization = "Bearer " .. bearer,
            ["X-Player"] = PLAYER,
            -- Der Server prueft, ob der Schluessel zu diesem Skript gehoert
            ["X-Product"] = PRODUCT,
        },
        Body = "",
    })
    if not ok or type(response) ~= "table" then return nil end
    return response
end

local busy = false

-- given ist der gespeicherte oder aus der Zwischenablage geholte Schluessel.
-- Ohne Angabe wird das Eingabefeld benutzt.
local function attempt(given)
    if busy then return end
    busy = true
    unlock.Text = "Checking…"

    local key = (given or input.Text):match("^%s*(.-)%s*$") or ""

    local function fail(message)
        say(message)
        unlock.Text = "Verify key & launch"
        busy = false
    end

    if key == "" then return fail("Paste your key first.") end

    -- Schritt 1: Schluessel pruefen und Einmal-Ticket holen
    local response = api("/api/authorize", key)
    if not response then return fail("Cannot reach the key server. Check your connection.") end
    if response.StatusCode == 401 then
        forgetKey(key)
        rememberReject(key)
        return fail("That key is invalid or expired. Get a new one on the website.")
    end
    if response.StatusCode == 403 then
        forgetKey(key)
        rememberReject(key)
        return fail("That key is not for " .. SCRIPT_NAME
            .. ", or it belongs to another Roblox account. "
            .. "Get a " .. SCRIPT_NAME .. " key on the website.")
    end
    if response.StatusCode == 429 then
        -- Nicht dauerhaft merken, die Abrufe koennen zurueckgesetzt werden.
        forgetKey(key)
        return fail("That key has been used too often. Get a new one on the website.")
    end
    if response.StatusCode ~= 200 then
        return fail("Key server error (" .. tostring(response.StatusCode) .. "). Try again shortly.")
    end

    local decoded, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not decoded or not data.valid or type(data.remaining) ~= "number" or type(data.ticket) ~= "string" then
        return fail("Unexpected answer from the key server.")
    end

    -- Schritt 2: Hauptskript gegen das Ticket laden
    say("Key accepted. Loading script…", true)
    saveKey(key)
    local deadline = os.clock() + data.remaining
    local payload = api("/api/script", data.ticket)
    if not payload or payload.StatusCode ~= 200 then
        return fail("Could not download the script. Please try again.")
    end

    local chunk, compileError = loadstring(payload.Body)
    if not chunk then
        warn("[JLCFG] " .. tostring(compileError))
        return fail("The script could not be compiled.")
    end

    local built, start = pcall(chunk)
    if not built or type(start) ~= "function" then
        return fail("The script could not be initialised.")
    end

    ------------------------------------------------------------- Lizenzwache

    local license = { active = true, deadline = deadline, threads = {}, cleanups = {} }

    function license.stop(reason)
        if not license.active then return end
        license.active = false
        for _, cleanup in ipairs(license.cleanups) do pcall(cleanup) end
        for thread in pairs(license.threads) do pcall(task.cancel, thread) end
        env.JLCFG_RUNNING = nil
        warn("[JLCFG] " .. reason .. " Rejoin to reset everything. New key at " .. PAGE)
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "JLCFG",
                Text = reason .. " Rejoin, then unlock again.",
                Duration = 15,
            })
        end)
    end

    env.JLCFG_RUNNING = true
    gui:Destroy()

    -- Regelmaessig nachfragen, ob der Schluessel noch gilt
    task.spawn(function()
        local nextCheck, failures = os.clock() + 60, 0
        while license.active do
            task.wait(1)
            if os.clock() >= license.deadline then
                forgetKey()
                license.stop("Your key expired.")
                break
            end
            if os.clock() >= nextCheck then
                nextCheck = os.clock() + 60
                local check = api("/api/validate", key)
                if check and check.StatusCode == 401 then
                    forgetKey()
                    license.stop("Your key expired or was revoked.")
                    break
                end
                local good, result = pcall(function()
                    return HttpService:JSONDecode(check and check.Body or "")
                end)
                if check and check.StatusCode == 200 and good and result.valid
                    and type(result.remaining) == "number" then
                    failures = 0
                    license.deadline = math.min(license.deadline, os.clock() + result.remaining)
                else
                    failures = failures + 1
                    if failures >= 3 then
                        license.stop("The key server is unreachable.")
                        break
                    end
                end
            end
        end
    end)

    local started, failure = pcall(start, license)
    if not started then
        warn("[JLCFG] " .. tostring(failure))
        license.stop("The script failed to start.")
    end
end

